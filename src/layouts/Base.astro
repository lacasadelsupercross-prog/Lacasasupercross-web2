---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const SITE_NAME = "La Casa del Súper Cross";
const DEFAULT_DESC = "Repuestos y servicios para motos en Riobamba, Ecuador. Amortiguadores, frenos, motor, transmisión y más. Consulta por WhatsApp.";
const DEFAULT_OG = "/og-default.jpg";

const { title = SITE_NAME, description = DEFAULT_DESC, ogImage = DEFAULT_OG, canonicalUrl } = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = canonicalUrl ?? Astro.url.href;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_EC" />
  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body class="min-h-screen flex flex-col bg-white text-[#111] font-sans">

  <!-- Navbar -->
  <header class="sticky top-0 z-50 bg-[#111] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-6">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <img src="/logo.png" alt="La Casa del Súper Cross" class="h-10 w-auto" />
        <div class="hidden sm:block leading-none">
          <p class="text-white font-extrabold text-sm tracking-tight">La Casa del</p>
          <p class="text-[#E85A0C] font-extrabold text-sm tracking-tight">Súper Cross</p>
        </div>
      </a>

      <!-- Nav links -->
      <nav class="flex items-center gap-1 text-sm font-medium">
        <a
          href="/"
          class:list={[
            "px-3 py-2 rounded-lg transition-colors",
            currentPath === "/" ? "text-[#E85A0C] bg-white/10" : "text-white/70 hover:text-white hover:bg-white/10"
          ]}
        >Inicio</a>
        <a
          href="/catalogo"
          class:list={[
            "px-3 py-2 rounded-lg transition-colors",
            currentPath.startsWith("/catalogo") ? "text-[#E85A0C] bg-white/10" : "text-white/70 hover:text-white hover:bg-white/10"
          ]}
        >Catálogo</a>
        <a
          href="/#servicios"
          class="px-3 py-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors"
        >Servicios</a>

        <!-- Carrito -->
        <a
          href="/carrito"
          class:list={[
            "relative p-2 rounded-lg transition-colors",
            currentPath === "/carrito" ? "text-[#E85A0C] bg-white/10" : "text-white/70 hover:text-white hover:bg-white/10"
          ]}
          title="Carrito de compras"
          id="nav-carrito"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span
            id="cart-badge"
            class="absolute -top-0.5 -right-0.5 bg-[#E85A0C] text-white text-[10px] font-extrabold rounded-full h-4 w-4 items-center justify-center hidden"
          >0</span>
        </a>

        <a
          href="https://wa.me/593968309908?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20repuestos%20de%20motos."
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors font-semibold text-sm"
        >
          <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- Contenido -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-[#111] text-white/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">

      <!-- Fila superior: marca + mapa -->
      <div class="flex flex-col sm:flex-row gap-6 pb-10 border-b border-white/10 mb-10">
        <!-- Marca -->
        <div class="space-y-3 sm:w-56 shrink-0">
          <div class="flex items-center gap-2.5">
            <img src="/logo.png" alt="La Casa del Súper Cross" class="h-10 w-auto brightness-0 invert opacity-80" />
            <span class="text-white font-extrabold text-sm">La Casa del Súper Cross</span>
          </div>
          <p class="text-sm leading-relaxed">Tu taller de confianza para repuestos y mantenimiento de motos en Riobamba.</p>
          <p class="text-xs text-white/30 italic">Hecho para mecánicos</p>
        </div>

        <!-- Mapa Google Maps -->
        <div class="flex-1 rounded-[10px] overflow-hidden" style="min-height:220px;">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7976.273838736936!2d-78.6497874!3d-1.6634585000000002!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x91d3a97fdbc86cf3%3A0x55e28e32b35630ce!2sLa%20Casa%20del%20S%C3%BAper%20Cross!5e0!3m2!1ses-419!2sec!4v1782745453475!5m2!1ses-419!2sec"
            width="100%"
            height="220"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
      </div>

      <!-- Fila inferior: tienda + contacto -->
      <div class="grid sm:grid-cols-2 gap-10">
        <div class="space-y-3">
          <p class="text-white font-semibold text-sm">Tienda</p>
          <nav class="flex flex-col gap-2 text-sm">
            <a href="/" class="hover:text-white transition-colors">Inicio</a>
            <a href="/catalogo" class="hover:text-white transition-colors">Catálogo de repuestos</a>
            <a href="/#servicios" class="hover:text-white transition-colors">Servicios del taller</a>
            <a href="/carrito" class="hover:text-white transition-colors">Carrito de compras</a>
          </nav>
        </div>

        <div class="space-y-3">
          <p class="text-white font-semibold text-sm">Contacto</p>

          <!-- WhatsApp taller -->
          <a
            href="https://wa.me/593968309908"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-green-400 hover:text-green-300 transition-colors text-sm"
          >
            <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            0968 309 908 (Taller)
          </a>

          <!-- Teléfono dueño -->
          <a
            href="tel:+593980881099"
            class="flex items-center gap-2 text-sm hover:text-white transition-colors"
          >
            <svg class="h-4 w-4 shrink-0 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +593 98 088 1099 (Dueño)
          </a>

          <!-- Dirección -->
          <div class="flex items-start gap-2 text-sm">
            <svg class="h-4 w-4 shrink-0 mt-0.5 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Av. de los Héroes 30-57 y Lavalle, Riobamba
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 py-4 text-center text-xs text-white/25">
      © {new Date().getFullYear()} La Casa del Súper Cross — Riobamba, Ecuador
    </div>
  </footer>

  <!-- Script global: badge del carrito en navbar -->
  <script>
    function actualizarBadge() {
      try {
        const items = JSON.parse(localStorage.getItem("carrito_supercross") ?? "[]") as Array<{ cantidad: number }>;
        const total = items.reduce((s, i) => s + i.cantidad, 0);
        const badge = document.getElementById("cart-badge");
        if (!badge) return;
        if (total > 0) {
          badge.textContent = total > 99 ? "99+" : String(total);
          badge.classList.remove("hidden");
          badge.classList.add("flex");
        } else {
          badge.classList.add("hidden");
          badge.classList.remove("flex");
        }
      } catch {}
    }

    actualizarBadge();
    document.addEventListener("carrito:cambio", actualizarBadge);
  </script>

</body>
</html>
