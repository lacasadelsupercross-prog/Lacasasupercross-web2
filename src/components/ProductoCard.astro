---
import type { Producto } from "../lib/productos";
import { precioPublico, getPromoActiva } from "../lib/productos";
import { slugify } from "../lib/slugify";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const slug = slugify(producto.nombre, producto.codigo_interno);
const promo = getPromoActiva(producto);
const precioEfectivo = promo ? promo.precioPromo : precioPublico(producto.precio_venta);
---

<article class="group flex flex-col bg-white rounded-[12px] border border-black/10 overflow-hidden hover:shadow-lg hover:border-[#E85A0C]/30 transition-all duration-300 hover:-translate-y-0.5">

  <!-- Imagen -->
  <a href={`/catalogo/${slug}`} class="relative block aspect-square bg-[#F5F0E8] overflow-hidden">
    {producto.imagen_url ? (
      <img
        src={producto.imagen_url}
        alt={producto.nombre}
        class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg class="w-12 h-12 text-black/15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}

    <!-- Badge promo -->
    {promo && (
      <div class="absolute top-2 left-2 bg-[#E85A0C] text-white text-[11px] font-bold px-2 py-0.5 rounded-[6px]">
        -{promo.porcentaje}%
      </div>
    )}
  </a>

  <!-- Info -->
  <div class="flex flex-col flex-1 p-3 gap-1">
    <!-- Código monospace -->
    <span class="font-mono text-[10px] text-black/35 tracking-wide">
      {producto.codigo_interno}
    </span>

    {producto.marca && (
      <span class="text-[11px] font-bold text-[#E85A0C] uppercase tracking-wide">{producto.marca.nombre}</span>
    )}

    <a href={`/catalogo/${slug}`} class="text-sm font-semibold text-[#111] line-clamp-2 hover:text-[#E85A0C] transition-colors leading-snug mt-0.5">
      {producto.nombre}
    </a>

    <!-- Precio -->
    <div class="mt-auto pt-2">
      {promo ? (
        <div class="flex items-baseline gap-1.5">
          <span class="text-base font-extrabold text-[#E85A0C]">${promo.precioPromo}</span>
          <span class="text-xs text-black/35 line-through">${promo.precioOriginal}</span>
        </div>
      ) : (
        <span class="text-base font-extrabold text-[#E85A0C]">${precioPublico(producto.precio_venta)}</span>
      )}
      <p class="text-[10px] text-black/35 mt-0.5">IVA incluido</p>
    </div>

    <!-- CTA -->
    <button
      class="btn-agregar-carrito mt-2 flex items-center justify-center gap-2 w-full bg-[#111] hover:bg-[#E85A0C] text-white text-xs font-semibold py-2.5 px-3 rounded-[8px] transition-colors duration-200"
      data-id={producto.codigo_interno}
      data-uuid={producto.id}
      data-nombre={producto.nombre}
      data-codigo={producto.codigo_interno}
      data-precio={precioEfectivo}
      data-imagen={producto.imagen_url ?? ""}
    >
      <svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <span class="btn-texto">Agregar al carrito</span>
    </button>
  </div>
</article>

<script>
  import { agregarAlCarrito } from "../lib/carrito";

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".btn-agregar-carrito") as HTMLButtonElement | null;
    if (!btn) return;

    agregarAlCarrito({
      id: btn.dataset.id!,
      uuid: btn.dataset.uuid ?? "",
      nombre: btn.dataset.nombre!,
      codigo: btn.dataset.codigo!,
      precio: btn.dataset.precio!,
      imagen: btn.dataset.imagen ?? "",
    });

    const texto = btn.querySelector(".btn-texto");
    if (!texto) return;
    const original = texto.textContent;
    btn.classList.add("bg-green-600");
    btn.classList.remove("bg-[#111]", "hover:bg-[#E85A0C]");
    texto.textContent = "¡Agregado!";
    setTimeout(() => {
      texto.textContent = original;
      btn.classList.remove("bg-green-600");
      btn.classList.add("bg-[#111]", "hover:bg-[#E85A0C]");
    }, 1500);
  });
</script>
