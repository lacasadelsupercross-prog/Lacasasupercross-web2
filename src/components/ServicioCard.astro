---
import type { Servicio } from "../lib/productos";
import { urlServicio } from "../lib/whatsapp";

interface Props {
  servicio: Servicio;
}

const { servicio } = Astro.props;
const waUrl = urlServicio(servicio.nombre);
---

<div class="flex flex-col bg-white rounded-[12px] border border-black/10 p-5 hover:shadow-md hover:border-[#E85A0C]/30 transition-all duration-300">
  <div class="flex-1">
    <h3 class="font-bold text-[#111] text-sm leading-snug">{servicio.nombre}</h3>
    {servicio.descripcion && (
      <p class="text-xs text-black/50 mt-1.5 leading-relaxed line-clamp-3">{servicio.descripcion}</p>
    )}
  </div>

  <div class="flex items-center justify-between mt-4 pt-3 border-t border-black/8">
    <div>
      <p class="text-[10px] text-black/35 uppercase tracking-wide">Precio</p>
      <p class="text-lg font-extrabold text-[#E85A0C]">${servicio.precio.toFixed(2)}</p>
    </div>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 bg-[#111] hover:bg-[#E85A0C] text-white text-xs font-semibold px-4 py-2 rounded-[8px] transition-colors duration-200"
    >
      Agendar
    </a>
  </div>
</div>
