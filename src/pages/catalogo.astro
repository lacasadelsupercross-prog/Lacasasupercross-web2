---
import Base from "../layouts/Base.astro";
import ProductoCard from "../components/ProductoCard.astro";
import FiltrosCatalogo from "../components/FiltrosCatalogo.astro";
import { getProductosActivos, getCategorias, getMarcas } from "../lib/productos";

const productos = await getProductosActivos();
const categorias = getCategorias(productos);
const marcas = getMarcas(productos);
---

<Base
  title="Catálogo de repuestos | La Casa del Súper Cross"
  description={`${productos.length} repuestos para motos disponibles en Riobamba. Filtra por categoría o marca y consulta por WhatsApp.`}
>

  <!-- Header de página -->
  <div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
      <nav class="text-sm text-gray-400 mb-3 flex items-center gap-1.5">
        <a href="/" class="hover:text-orange-500 transition-colors">Inicio</a>
        <span>›</span>
        <span class="text-gray-700 font-medium">Catálogo</span>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Catálogo de repuestos</h1>
      <p class="text-gray-500 text-sm mt-1">{productos.length} productos disponibles</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-6">
    <!-- Filtros -->
    <FiltrosCatalogo categorias={categorias} marcas={marcas} />

    <!-- Grid -->
    {productos.length === 0 ? (
      <div class="text-center py-24 text-gray-400">
        <div class="text-6xl mb-4">🔧</div>
        <p class="text-lg font-semibold text-gray-500">Sin productos disponibles por el momento</p>
        <p class="text-sm mt-1">Contáctanos por WhatsApp para consultar disponibilidad</p>
      </div>
    ) : (
      <div id="grid-productos" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {productos.map(p => (
          <div
            data-producto
            data-nombre={p.nombre}
            data-categoria={p.categoria?.id ?? ""}
            data-marca={p.marca?.id ?? ""}
          >
            <ProductoCard producto={p} />
          </div>
        ))}
      </div>
    )}
  </div>

</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get("categoria");
  const marcaParam = params.get("marca");

  if (catParam) {
    const sel = document.getElementById("filtro-categoria") as HTMLSelectElement;
    if (sel) { sel.value = catParam; sel.dispatchEvent(new Event("change")); }
  }
  if (marcaParam) {
    const sel = document.getElementById("filtro-marca") as HTMLSelectElement;
    if (sel) { sel.value = marcaParam; sel.dispatchEvent(new Event("change")); }
  }
</script>
