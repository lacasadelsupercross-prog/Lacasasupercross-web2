---
import Base from "../../layouts/Base.astro";
import ProductoCard from "../../components/ProductoCard.astro";
import { getProductosActivos, precioPublico, getPromoActiva } from "../../lib/productos";
import { slugify } from "../../lib/slugify";
import { urlConsulta, urlGeneral } from "../../lib/whatsapp";

export async function getStaticPaths() {
  const productos = await getProductosActivos();
  return productos.map(p => ({
    params: { slug: slugify(p.nombre, p.codigo_interno) },
    props: { producto: p, todos: productos },
  }));
}

const { producto, todos } = Astro.props;
const precio = precioPublico(producto.precio_venta);
const promo = getPromoActiva(producto);
const waUrl = urlConsulta(producto.nombre, producto.codigo_interno);

const relacionados = todos
  .filter(p => p.id !== producto.id && p.categoria?.id === producto.categoria?.id)
  .slice(0, 4);
---

<Base
  title={`${producto.nombre} | La Casa del Súper Cross`}
  description={producto.descripcion ?? `Compra ${producto.nombre} en Riobamba. Consulta disponibilidad por WhatsApp.`}
  ogImage={producto.imagen_url ?? undefined}
>

  <!-- Breadcrumb strip -->
  <div class="bg-[#111] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
      <nav class="text-xs text-white/30 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-[#E85A0C] transition-colors">Inicio</a>
        <span>›</span>
        <a href="/catalogo" class="hover:text-[#E85A0C] transition-colors">Catálogo</a>
        {producto.categoria && (
          <>
            <span>›</span>
            <a href={`/catalogo?categoria=${producto.categoria.id}`} class="hover:text-[#E85A0C] transition-colors">
              {producto.categoria.nombre}
            </a>
          </>
        )}
        <span>›</span>
        <span class="text-white/50 truncate max-w-[180px]">{producto.nombre}</span>
      </nav>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Producto principal -->
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 mb-16">

      <!-- Imagen -->
      <div class="relative">
        <div class="aspect-square rounded-[12px] bg-[#F5F0E8] border border-black/8 overflow-hidden flex items-center justify-center">
          {producto.imagen_url ? (
            <img src={producto.imagen_url} alt={producto.nombre} class="w-full h-full object-contain p-8" />
          ) : (
            <div class="flex flex-col items-center gap-3 text-black/20">
              <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm">Sin imagen disponible</p>
            </div>
          )}
        </div>
        {promo && (
          <div class="absolute top-3 left-3 bg-[#E85A0C] text-white text-xs font-extrabold px-3 py-1 rounded-[6px]">
            -{promo.porcentaje}% OFERTA
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="flex flex-col gap-4">
        <!-- Código referencia -->
        <span class="font-mono text-xs text-black/35 tracking-widest uppercase">{producto.codigo_interno}</span>

        {producto.marca && (
          <span class="text-xs font-bold text-[#E85A0C] uppercase tracking-widest">{producto.marca.nombre}</span>
        )}

        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#111] leading-tight">{producto.nombre}</h1>

        {producto.categoria && (
          <a
            href={`/catalogo?categoria=${producto.categoria.id}`}
            class="self-start text-xs bg-[#F5F0E8] border border-black/8 text-black/50 hover:text-[#E85A0C] hover:border-[#E85A0C]/30 px-3 py-1.5 rounded-full transition-colors font-medium"
          >
            {producto.categoria.nombre}
          </a>
        )}

        {producto.descripcion && (
          <p class="text-sm text-black/55 leading-relaxed border-t border-black/8 pt-4">{producto.descripcion}</p>
        )}

        <!-- Precio -->
        <div class="bg-[#F5F0E8] rounded-[12px] border border-black/8 p-5 space-y-1.5">
          <p class="text-xs text-black/35 uppercase tracking-wide font-medium">
            {promo ? "Precio en oferta" : "Precio público"} — IVA incluido
          </p>
          {promo ? (
            <>
              <div class="flex items-baseline gap-3">
                <span class="text-4xl font-extrabold text-[#E85A0C]">${promo.precioPromo}</span>
                <span class="text-lg text-black/35 line-through">${promo.precioOriginal}</span>
              </div>
              <p class="text-sm text-green-700 font-semibold">Ahorras ${promo.ahorro}</p>
              {producto.promo_fecha_fin && (
                <p class="text-xs text-black/35">
                  Oferta hasta el {new Date(producto.promo_fecha_fin + "T00:00:00").toLocaleDateString("es-EC", { day: "numeric", month: "long" })}
                </p>
              )}
            </>
          ) : (
            <p class="text-4xl font-extrabold text-[#E85A0C]">${precio}</p>
          )}
        </div>

        <!-- Botones -->
        <div class="space-y-2.5">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-[#111] hover:bg-[#E85A0C] text-white font-bold py-4 px-6 rounded-[8px] transition-colors duration-200 w-full text-sm"
          >
            <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Consultar disponibilidad por WhatsApp
          </a>
          <a href="/catalogo" class="flex items-center justify-center text-sm text-black/40 hover:text-[#E85A0C] transition-colors py-2">
            ← Volver al catálogo
          </a>
        </div>
        <p class="text-xs text-black/30 text-center">Te redirigirá a WhatsApp con el mensaje listo</p>
      </div>
    </div>

    <!-- Relacionados -->
    {relacionados.length > 0 && (
      <div class="border-t border-black/8 pt-10">
        <h2 class="text-lg font-extrabold text-[#111] mb-6">
          Más de {producto.categoria?.nombre ?? "este catálogo"}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {relacionados.map(p => <ProductoCard producto={p} />)}
        </div>
      </div>
    )}

  </div>
</Base>
