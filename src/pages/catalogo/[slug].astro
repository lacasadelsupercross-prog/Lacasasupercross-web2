---
import Base from "../../layouts/Base.astro";
import ProductoCard from "../../components/ProductoCard.astro";
import { getProductosActivos, precioPublico } from "../../lib/productos";
import { slugify } from "../../lib/slugify";
import { urlConsulta, urlGeneral } from "../../lib/whatsapp";

export async function getStaticPaths() {
  const productos = await getProductosActivos();
  return productos.map(p => ({
    params: { slug: slugify(p.nombre, p.codigo_interno) },
    props: { producto: p, todos: productos },
  }));
}

const { producto, todos } = Astro.props;
const precio = precioPublico(producto.precio_venta);
const waUrl = urlConsulta(producto.nombre, producto.codigo_interno);

// Productos relacionados: misma categoría, máximo 4, excluyendo el actual
const relacionados = todos
  .filter(p => p.id !== producto.id && p.categoria?.id === producto.categoria?.id)
  .slice(0, 4);
---

<Base
  title={`${producto.nombre} | La Casa del Súper Cross`}
  description={producto.descripcion ?? `Compra ${producto.nombre} en Riobamba. Consulta disponibilidad y precio por WhatsApp.`}
  ogImage={producto.imagen_url ?? undefined}
>
  <div class="max-w-5xl mx-auto px-4 py-8">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1">
      <a href="/" class="hover:text-orange-600">Inicio</a>
      <span>›</span>
      <a href="/catalogo" class="hover:text-orange-600">Catálogo</a>
      {producto.categoria && (
        <>
          <span>›</span>
          <a href={`/catalogo?categoria=${producto.categoria.id}`} class="hover:text-orange-600">
            {producto.categoria.nombre}
          </a>
        </>
      )}
      <span>›</span>
      <span class="text-gray-800 truncate max-w-[160px]">{producto.nombre}</span>
    </nav>

    <!-- Producto principal -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">

      <!-- Imagen -->
      <div class="aspect-square rounded-2xl border bg-gray-50 overflow-hidden flex items-center justify-center">
        {producto.imagen_url ? (
          <img
            src={producto.imagen_url}
            alt={producto.nombre}
            class="w-full h-full object-contain p-6"
          />
        ) : (
          <div class="text-gray-300 flex flex-col items-center gap-3">
            <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm">Sin imagen</p>
          </div>
        )}
      </div>

      <!-- Info -->
      <div class="flex flex-col gap-4">
        {producto.marca && (
          <span class="text-sm font-semibold text-orange-600 uppercase tracking-wide">
            {producto.marca.nombre}
          </span>
        )}

        <h1 class="text-2xl font-bold text-gray-900 leading-tight">{producto.nombre}</h1>

        {producto.categoria && (
          <a
            href={`/catalogo?categoria=${producto.categoria.id}`}
            class="inline-flex w-fit items-center gap-1 text-xs bg-gray-100 hover:bg-orange-100 text-gray-600 hover:text-orange-700 px-2 py-1 rounded-full transition-colors"
          >
            🔧 {producto.categoria.nombre}
          </a>
        )}

        <p class="text-xs text-gray-400 font-mono">Cód. {producto.codigo_interno}</p>

        {producto.descripcion && (
          <p class="text-gray-600 text-sm leading-relaxed border-t pt-4">{producto.descripcion}</p>
        )}

        <div class="border-t pt-4 mt-auto">
          <p class="text-sm text-gray-400 mb-1">Precio público (IVA incluido)</p>
          <p class="text-4xl font-extrabold text-gray-900">${precio}</p>
        </div>

        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-6 rounded-xl text-lg transition-colors shadow-lg shadow-green-200"
        >
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Consultar disponibilidad
        </a>

        <p class="text-xs text-gray-400 text-center">
          Te redirigirá a WhatsApp con el mensaje preparado
        </p>
      </div>
    </div>

    <!-- Productos relacionados -->
    {relacionados.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4">
          Otros productos de {producto.categoria?.nombre ?? "este catálogo"}
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {relacionados.map(p => <ProductoCard producto={p} />)}
        </div>
      </div>
    )}

  </div>
</Base>
