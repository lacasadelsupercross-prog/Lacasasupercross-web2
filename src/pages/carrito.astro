---
import Base from "../layouts/Base.astro";
---

<Base title="Carrito de compras | La Casa del Súper Cross" description="Revisa los productos que seleccionaste y realiza tu pedido por WhatsApp.">

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    <div class="flex items-center gap-3 mb-8">
      <svg class="h-7 w-7 text-[#111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <h1 class="text-2xl font-extrabold text-[#111]">Carrito de compras</h1>
    </div>

    <!-- Estado vacío -->
    <div id="carrito-vacio" class="text-center py-20">
      <svg class="w-20 h-20 text-black/10 mx-auto mb-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <p class="text-lg font-semibold text-black/40 mb-2">Tu carrito está vacío</p>
      <p class="text-sm text-black/30 mb-6">Agrega productos desde el catálogo</p>
      <a
        href="/catalogo"
        class="inline-flex items-center gap-2 bg-[#111] hover:bg-[#E85A0C] text-white font-semibold py-3 px-6 rounded-[8px] transition-colors text-sm"
      >
        Ver catálogo de repuestos
      </a>
    </div>

    <!-- Contenido del carrito -->
    <div id="carrito-contenido" class="hidden">

      <!-- Lista de items -->
      <div id="lista-items" class="space-y-3 mb-8"></div>

      <!-- Resumen y checkout -->
      <div class="border-t border-black/10 pt-6 space-y-5">

        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-black/40">Total estimado</p>
            <p class="text-xs text-black/30">Precios con IVA incluido</p>
          </div>
          <span id="total-carrito" class="text-3xl font-extrabold text-[#E85A0C]">$0.00</span>
        </div>

        <p class="text-xs text-black/35 bg-[#F5F0E8] rounded-[8px] p-3 leading-relaxed">
          Al hacer clic en "Pedir por WhatsApp" se abrirá una conversación con el detalle de tu pedido. El precio final puede variar según disponibilidad de stock.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/catalogo"
            class="flex-1 flex items-center justify-center gap-2 text-sm font-semibold py-3 px-4 rounded-[8px] border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors text-center"
          >
            ← Seguir comprando
          </a>
          <a
            id="btn-comprar-wa"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 bg-[#111] hover:bg-[#E85A0C] text-white font-bold py-3 px-6 rounded-[8px] transition-colors text-sm"
          >
            <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir por WhatsApp
          </a>
          <button
            id="btn-proforma"
            class="flex-1 flex items-center justify-center gap-2 bg-white border-2 border-[#111] hover:border-[#E85A0C] hover:text-[#E85A0C] text-[#111] font-bold py-3 px-6 rounded-[8px] transition-colors text-sm"
          >
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Solicitar Proforma
          </button>
        </div>

        <button
          id="btn-vaciar"
          class="w-full text-xs text-red-400 hover:text-red-600 transition-colors py-2 text-center"
        >
          Vaciar carrito
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Solicitar Proforma -->
  <div id="modal-proforma" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
    <div class="w-full max-w-md bg-white rounded-[16px] shadow-xl overflow-hidden">

      <!-- Cabecera modal -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-black/10">
        <div>
          <h2 class="text-lg font-bold text-[#111]">Solicitar Proforma</h2>
          <p class="text-xs text-black/40 mt-0.5">Te enviaremos la cotización por WhatsApp</p>
        </div>
        <button id="btn-cerrar-modal" class="text-black/30 hover:text-black transition-colors p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Formulario -->
      <form id="form-proforma" class="px-6 py-5 space-y-4">
        <div>
          <label for="pf-nombre" class="block text-sm font-semibold text-[#111] mb-1.5">Nombre completo</label>
          <input
            id="pf-nombre"
            type="text"
            required
            placeholder="Ej: Juan Pérez"
            class="w-full border border-black/20 rounded-[8px] px-3 py-2.5 text-sm focus:outline-none focus:border-[#E85A0C] transition-colors"
          />
        </div>
        <div>
          <label for="pf-telefono" class="block text-sm font-semibold text-[#111] mb-1.5">Teléfono / WhatsApp</label>
          <input
            id="pf-telefono"
            type="tel"
            required
            placeholder="Ej: 0998765432"
            class="w-full border border-black/20 rounded-[8px] px-3 py-2.5 text-sm focus:outline-none focus:border-[#E85A0C] transition-colors"
          />
        </div>
        <div>
          <label for="pf-email" class="block text-sm font-semibold text-[#111] mb-1.5">
            Correo electrónico <span class="text-black/30 font-normal">(opcional)</span>
          </label>
          <input
            id="pf-email"
            type="email"
            placeholder="Ej: juan@gmail.com"
            class="w-full border border-black/20 rounded-[8px] px-3 py-2.5 text-sm focus:outline-none focus:border-[#E85A0C] transition-colors"
          />
        </div>
        <p id="pf-error" class="hidden text-xs text-red-500 bg-red-50 rounded-[6px] px-3 py-2"></p>
        <button
          type="submit"
          id="btn-enviar-proforma"
          class="w-full bg-[#111] hover:bg-[#E85A0C] text-white font-bold py-3 rounded-[8px] transition-colors text-sm"
        >
          Enviar solicitud
        </button>
      </form>

      <!-- Confirmación -->
      <div id="pf-confirmacion" class="hidden px-6 pb-6 pt-2 text-center space-y-3">
        <div class="w-14 h-14 bg-green-50 rounded-full flex items-center justify-center mx-auto">
          <svg class="w-7 h-7 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <p class="text-base font-bold text-[#111]">¡Solicitud enviada!</p>
        <p class="text-sm text-black/50">Recibirás tu proforma por WhatsApp en breve.</p>
        <button
          id="btn-cerrar-confirm"
          class="w-full border border-black/15 rounded-[8px] py-2.5 text-sm font-semibold text-[#111] hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors"
        >
          Cerrar
        </button>
      </div>

    </div>
  </div>

</Base>

<script>
  import { getCarrito, actualizarCantidad, vaciarCarrito } from "../lib/carrito";
  import { urlCarrito } from "../lib/whatsapp";
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://kpqrcufbnicyubzilkgq.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtwcXJjdWZibmljeXViemlsa2dxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2MjEzODgsImV4cCI6MjA5NjE5NzM4OH0.dy5dX9Bv3bPacaAwTkF73ACL1PnNQn23xUV3SMszL2c";
  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  function render() {
    const items = getCarrito();
    const elVacio = document.getElementById("carrito-vacio")!;
    const elContenido = document.getElementById("carrito-contenido")!;

    if (items.length === 0) {
      elVacio.classList.remove("hidden");
      elContenido.classList.add("hidden");
      return;
    }

    elVacio.classList.add("hidden");
    elContenido.classList.remove("hidden");

    const lista = document.getElementById("lista-items")!;
    lista.innerHTML = items.map(item => `
      <div class="flex items-center gap-4 p-4 bg-white border border-black/10 rounded-[12px] hover:border-[#E85A0C]/20 transition-colors">
        <div class="w-16 h-16 bg-[#F5F0E8] rounded-[8px] shrink-0 overflow-hidden flex items-center justify-center">
          ${item.imagen
            ? `<img src="${item.imagen}" alt="${item.nombre}" class="w-full h-full object-contain p-2" loading="lazy">`
            : `<svg class="w-7 h-7 text-black/15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
          }
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-mono text-[10px] text-black/35 tracking-wide">${item.codigo}</p>
          <p class="text-sm font-semibold text-[#111] line-clamp-2 leading-snug">${item.nombre}</p>
          <p class="text-[#E85A0C] font-bold text-sm mt-0.5">$${item.precio} <span class="text-black/30 text-xs font-normal">c/u</span></p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button
            class="btn-menos w-8 h-8 flex items-center justify-center rounded-full border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors font-bold text-base"
            data-id="${item.id}"
          >−</button>
          <span class="w-7 text-center text-sm font-bold">${item.cantidad}</span>
          <button
            class="btn-mas w-8 h-8 flex items-center justify-center rounded-full border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors font-bold text-base"
            data-id="${item.id}"
          >+</button>
        </div>
        <div class="shrink-0 text-right ml-2 hidden sm:block">
          <p class="text-sm font-extrabold text-[#111]">$${(parseFloat(item.precio) * item.cantidad).toFixed(2)}</p>
          <p class="text-[10px] text-black/30">subtotal</p>
        </div>
        <button
          class="btn-eliminar shrink-0 ml-1 text-black/20 hover:text-red-500 transition-colors p-1"
          data-id="${item.id}"
          title="Eliminar"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    `).join("");

    const total = items.reduce((s, i) => s + parseFloat(i.precio) * i.cantidad, 0);
    document.getElementById("total-carrito")!.textContent = `$${total.toFixed(2)}`;

    const btnWa = document.getElementById("btn-comprar-wa") as HTMLAnchorElement;
    btnWa.href = urlCarrito(items.map(i => ({
      nombre: i.nombre,
      codigo: i.codigo,
      precio: i.precio,
      cantidad: i.cantidad,
    })));
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const btnMenos    = target.closest(".btn-menos") as HTMLElement | null;
    const btnMas      = target.closest(".btn-mas") as HTMLElement | null;
    const btnEliminar = target.closest(".btn-eliminar") as HTMLElement | null;
    const btnVaciar   = target.closest("#btn-vaciar");

    if (btnMenos) {
      const items = getCarrito();
      const item = items.find(i => i.id === btnMenos.dataset.id);
      if (item) actualizarCantidad(item.id, item.cantidad - 1);
      render();
    } else if (btnMas) {
      const items = getCarrito();
      const item = items.find(i => i.id === btnMas.dataset.id);
      if (item) actualizarCantidad(item.id, item.cantidad + 1);
      render();
    } else if (btnEliminar) {
      actualizarCantidad(btnEliminar.dataset.id!, 0);
      render();
    } else if (btnVaciar) {
      if (confirm("¿Vaciar el carrito?")) {
        vaciarCarrito();
        render();
      }
    }
  });

  // ── Modal Proforma ───────────────────────────────────────────────────────────

  const modal        = document.getElementById("modal-proforma")!;
  const form         = document.getElementById("form-proforma")!;
  const confirmacion = document.getElementById("pf-confirmacion")!;
  const btnError     = document.getElementById("pf-error")!;

  function abrirModal() {
    form.classList.remove("hidden");
    confirmacion.classList.add("hidden");
    btnError.classList.add("hidden");
    (document.getElementById("pf-nombre") as HTMLInputElement).value = "";
    (document.getElementById("pf-telefono") as HTMLInputElement).value = "";
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  }

  function cerrarModal() {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  document.getElementById("btn-proforma")!.addEventListener("click", abrirModal);
  document.getElementById("btn-cerrar-modal")!.addEventListener("click", cerrarModal);
  document.getElementById("btn-cerrar-confirm")!.addEventListener("click", cerrarModal);

  // Cerrar al hacer clic fuera del modal
  modal.addEventListener("click", (e) => {
    if (e.target === modal) cerrarModal();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const nombre   = (document.getElementById("pf-nombre") as HTMLInputElement).value.trim();
    const telefono = (document.getElementById("pf-telefono") as HTMLInputElement).value.trim();
    const email    = (document.getElementById("pf-email") as HTMLInputElement).value.trim() || null;
    const btnEnviar = document.getElementById("btn-enviar-proforma") as HTMLButtonElement;

    if (!nombre || !telefono) return;

    btnEnviar.disabled = true;
    btnEnviar.textContent = "Enviando...";
    btnError.classList.add("hidden");

    const items = getCarrito();

    try {
      // 1. Crear proforma
      const { data: proforma, error: errPf } = await (supabase as any)
        .from("proformas")
        .insert({ nombre_cliente: nombre, telefono_cliente: telefono, email_cliente: email })
        .select("id")
        .single();

      if (errPf || !proforma) throw new Error(errPf?.message ?? "Error al crear la proforma");

      // 2. Insertar ítems
      const itemsInsert = items.map(item => ({
        proforma_id:         proforma.id,
        producto_id:         item.id,
        nombre_producto:     item.nombre,
        precio_unitario:     parseFloat(item.precio),
        cantidad_solicitada: item.cantidad,
        cantidad_proforma:   item.cantidad,
      }));

      const { error: errItems } = await (supabase as any)
        .from("proforma_items")
        .insert(itemsInsert);

      if (errItems) throw new Error(errItems.message);

      // 3. Mostrar confirmación
      form.classList.add("hidden");
      confirmacion.classList.remove("hidden");

    } catch (err: any) {
      btnError.textContent = err?.message ?? "Error al enviar la solicitud. Intenta de nuevo.";
      btnError.classList.remove("hidden");
    } finally {
      btnEnviar.disabled = false;
      btnEnviar.textContent = "Enviar solicitud";
    }
  });

  render();
</script>
