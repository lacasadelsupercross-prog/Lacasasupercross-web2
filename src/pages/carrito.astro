---
import Base from "../layouts/Base.astro";
---

<Base title="Carrito de compras | La Casa del Súper Cross" description="Revisa los productos que seleccionaste y realiza tu pedido por WhatsApp.">

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">

    <div class="flex items-center gap-3 mb-8">
      <svg class="h-7 w-7 text-[#111]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <h1 class="text-2xl font-extrabold text-[#111]">Carrito de compras</h1>
    </div>

    <!-- Estado vacío -->
    <div id="carrito-vacio" class="text-center py-20">
      <svg class="w-20 h-20 text-black/10 mx-auto mb-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <p class="text-lg font-semibold text-black/40 mb-2">Tu carrito está vacío</p>
      <p class="text-sm text-black/30 mb-6">Agrega productos desde el catálogo</p>
      <a
        href="/catalogo"
        class="inline-flex items-center gap-2 bg-[#111] hover:bg-[#E85A0C] text-white font-semibold py-3 px-6 rounded-[8px] transition-colors text-sm"
      >
        Ver catálogo de repuestos
      </a>
    </div>

    <!-- Contenido del carrito -->
    <div id="carrito-contenido" class="hidden">

      <!-- Lista de items -->
      <div id="lista-items" class="space-y-3 mb-8"></div>

      <!-- Resumen y checkout -->
      <div class="border-t border-black/10 pt-6 space-y-5">

        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-black/40">Total estimado</p>
            <p class="text-xs text-black/30">Precios con IVA incluido</p>
          </div>
          <span id="total-carrito" class="text-3xl font-extrabold text-[#E85A0C]">$0.00</span>
        </div>

        <p class="text-xs text-black/35 bg-[#F5F0E8] rounded-[8px] p-3 leading-relaxed">
          Al hacer clic en "Pedir por WhatsApp" se abrirá una conversación con el detalle de tu pedido. El precio final puede variar según disponibilidad de stock.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/catalogo"
            class="flex-1 flex items-center justify-center gap-2 text-sm font-semibold py-3 px-4 rounded-[8px] border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors text-center"
          >
            ← Seguir comprando
          </a>
          <a
            id="btn-comprar-wa"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 flex items-center justify-center gap-2 bg-[#111] hover:bg-[#E85A0C] text-white font-bold py-3 px-6 rounded-[8px] transition-colors text-sm"
          >
            <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir por WhatsApp
          </a>
        </div>

        <button
          id="btn-vaciar"
          class="w-full text-xs text-red-400 hover:text-red-600 transition-colors py-2 text-center"
        >
          Vaciar carrito
        </button>
      </div>
    </div>
  </div>

</Base>

<script>
  import { getCarrito, actualizarCantidad, vaciarCarrito } from "../lib/carrito";
  import { urlCarrito } from "../lib/whatsapp";

  function render() {
    const items = getCarrito();
    const elVacio = document.getElementById("carrito-vacio")!;
    const elContenido = document.getElementById("carrito-contenido")!;

    if (items.length === 0) {
      elVacio.classList.remove("hidden");
      elContenido.classList.add("hidden");
      return;
    }

    elVacio.classList.add("hidden");
    elContenido.classList.remove("hidden");

    const lista = document.getElementById("lista-items")!;
    lista.innerHTML = items.map(item => `
      <div class="flex items-center gap-4 p-4 bg-white border border-black/10 rounded-[12px] hover:border-[#E85A0C]/20 transition-colors">
        <div class="w-16 h-16 bg-[#F5F0E8] rounded-[8px] shrink-0 overflow-hidden flex items-center justify-center">
          ${item.imagen
            ? `<img src="${item.imagen}" alt="${item.nombre}" class="w-full h-full object-contain p-2" loading="lazy">`
            : `<svg class="w-7 h-7 text-black/15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
          }
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-mono text-[10px] text-black/35 tracking-wide">${item.codigo}</p>
          <p class="text-sm font-semibold text-[#111] line-clamp-2 leading-snug">${item.nombre}</p>
          <p class="text-[#E85A0C] font-bold text-sm mt-0.5">$${item.precio} <span class="text-black/30 text-xs font-normal">c/u</span></p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button
            class="btn-menos w-8 h-8 flex items-center justify-center rounded-full border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors font-bold text-base"
            data-id="${item.id}"
          >−</button>
          <span class="w-7 text-center text-sm font-bold">${item.cantidad}</span>
          <button
            class="btn-mas w-8 h-8 flex items-center justify-center rounded-full border border-black/15 hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors font-bold text-base"
            data-id="${item.id}"
          >+</button>
        </div>
        <div class="shrink-0 text-right ml-2 hidden sm:block">
          <p class="text-sm font-extrabold text-[#111]">$${(parseFloat(item.precio) * item.cantidad).toFixed(2)}</p>
          <p class="text-[10px] text-black/30">subtotal</p>
        </div>
        <button
          class="btn-eliminar shrink-0 ml-1 text-black/20 hover:text-red-500 transition-colors p-1"
          data-id="${item.id}"
          title="Eliminar"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    `).join("");

    const total = items.reduce((s, i) => s + parseFloat(i.precio) * i.cantidad, 0);
    document.getElementById("total-carrito")!.textContent = `$${total.toFixed(2)}`;

    const btnWa = document.getElementById("btn-comprar-wa") as HTMLAnchorElement;
    btnWa.href = urlCarrito(items.map(i => ({
      nombre: i.nombre,
      codigo: i.codigo,
      precio: i.precio,
      cantidad: i.cantidad,
    })));
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const btnMenos = target.closest(".btn-menos") as HTMLElement | null;
    const btnMas = target.closest(".btn-mas") as HTMLElement | null;
    const btnEliminar = target.closest(".btn-eliminar") as HTMLElement | null;
    const btnVaciar = target.closest("#btn-vaciar");

    if (btnMenos) {
      const items = getCarrito();
      const item = items.find(i => i.id === btnMenos.dataset.id);
      if (item) actualizarCantidad(item.id, item.cantidad - 1);
      render();
    } else if (btnMas) {
      const items = getCarrito();
      const item = items.find(i => i.id === btnMas.dataset.id);
      if (item) actualizarCantidad(item.id, item.cantidad + 1);
      render();
    } else if (btnEliminar) {
      actualizarCantidad(btnEliminar.dataset.id!, 0);
      render();
    } else if (btnVaciar) {
      if (confirm("¿Vaciar el carrito?")) {
        vaciarCarrito();
        render();
      }
    }
  });

  render();
</script>
