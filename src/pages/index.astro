---
import Base from "../layouts/Base.astro";
import ProductoCard from "../components/ProductoCard.astro";
import { getProductosActivos, getCategorias } from "../lib/productos";
import { urlGeneral } from "../lib/whatsapp";

const productos = await getProductosActivos();
const categorias = getCategorias(productos);

// Destacados: primero los que tienen imagen, máximo 8
const destacados = [
  ...productos.filter(p => p.imagen_url),
  ...productos.filter(p => !p.imagen_url),
].slice(0, 8);

const waGeneral = urlGeneral();

const ICONOS: Record<string, string> = {
  "Motor": "⚙️", "Suspensión": "🔧", "Frenos": "🛑", "Transmisión": "⛓️",
  "Eléctrico": "⚡", "Carrocería": "🏍️", "Lubricantes": "🛢️", "Accesorios": "🎽",
  "Llantas": "🔵", "Filtros": "🔩", "Pastillas": "⬛", "Amortiguadores": "🔧",
};
---

<Base
  title="La Casa del Súper Cross | Repuestos de motos en Riobamba"
  description="Venta de repuestos para motos en Riobamba, Ecuador. Amortiguadores, frenos, motor, transmisión y más. Consulta por WhatsApp."
>

  <!-- Hero -->
  <section
    class="relative text-white py-20 px-4"
    style="background-image: url('/banner.jpeg'); background-size: cover; background-position: center top;"
  >
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative max-w-4xl mx-auto text-center space-y-6">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight drop-shadow-lg">
        Repuestos para motos<br/>
        <span class="text-orange-400">desde Riobamba</span>
      </h1>
      <p class="text-gray-300 text-lg max-w-xl mx-auto">
        Amortiguadores, frenos, motor, transmisión y más. Todo para mantener tu moto en marcha.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/catalogo" class="bg-orange-500 hover:bg-orange-600 text-white font-bold px-8 py-3 rounded-xl text-lg transition-colors">
          Ver catálogo
        </a>
        <a
          href={waGeneral}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3 rounded-xl text-lg transition-colors"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Categorías -->

  {categorias.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Categorías</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {categorias.map(cat => (
          <a
            href={`/catalogo?categoria=${cat.id}`}
            class="flex flex-col items-center gap-2 p-4 rounded-xl border border-gray-200 hover:border-orange-300 hover:bg-orange-50 transition-all text-center group"
          >
            <span class="text-3xl">{ICONOS[cat.nombre] ?? "🔩"}</span>
            <span class="text-sm font-semibold text-gray-700 group-hover:text-orange-600">{cat.nombre}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Productos destacados -->
  {destacados.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 pb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Productos destacados</h2>
        <a href="/catalogo" class="text-sm text-orange-600 hover:text-orange-700 font-medium">Ver todos →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        {destacados.map(p => <ProductoCard producto={p} />)}
      </div>
    </section>
  )}

  <!-- CTA WhatsApp -->
  <section class="bg-green-50 border-t border-green-100 py-12 px-4">
    <div class="max-w-xl mx-auto text-center space-y-4">
      <p class="text-3xl">📱</p>
      <h2 class="text-2xl font-bold text-gray-900">¿No encuentras lo que buscas?</h2>
      <p class="text-gray-600">Escríbenos por WhatsApp y te ayudamos a encontrar el repuesto que necesitas.</p>
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3 rounded-xl text-lg transition-colors"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>
  </section>

</Base>
