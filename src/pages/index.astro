---
import Base from "../layouts/Base.astro";
import ProductoCard from "../components/ProductoCard.astro";
import ServicioCard from "../components/ServicioCard.astro";
import { getProductosActivos, getServicios, getCategorias, getMarcas, getPromoActiva } from "../lib/productos";
import { urlGeneral } from "../lib/whatsapp";

const [productos, servicios] = await Promise.all([getProductosActivos(), getServicios()]);
const categorias = getCategorias(productos);
const marcas = getMarcas(productos);
const waGeneral = urlGeneral();

// Primero promos activas, luego con imagen, luego el resto
const enPromo = productos.filter(p => getPromoActiva(p));
const conImagen = productos.filter(p => p.imagen_url && !getPromoActiva(p));
const sinImagen = productos.filter(p => !p.imagen_url && !getPromoActiva(p));
const destacados = [...enPromo, ...conImagen, ...sinImagen].slice(0, 8);

const ICONOS_CATEGORIA: Record<string, string> = {
  "Motor": "⚙️", "Suspensión": "🔧", "Frenos": "🛑", "Transmisión": "⛓️",
  "Eléctrico": "⚡", "Carrocería": "🏍️", "Lubricantes": "🛢️", "Accesorios": "🎽",
  "Llantas": "🔵", "Filtros": "🔩", "Pastillas": "⬛", "Amortiguadores": "🔧",
};
---

<Base
  title="La Casa del Súper Cross | Repuestos y taller de motos en Riobamba"
  description="Repuestos y servicios de mantenimiento para motos en Riobamba, Ecuador. Consulta por WhatsApp."
>

  <!-- ── HERO ──────────────────────────────────────────────────────────── -->
  <section class="relative bg-[#111] min-h-[520px] sm:min-h-[580px] flex items-center overflow-hidden">
    <img
      src="/banner.jpeg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-luminosity"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#111]/95 via-[#111]/70 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-20 sm:py-28">
      <div class="max-w-lg space-y-5">
        <!-- Eyebrow -->
        <span class="inline-flex items-center gap-2 text-[#E85A0C] text-xs font-bold uppercase tracking-widest">
          <span class="w-5 h-px bg-[#E85A0C]"></span>
          Encuentra el repuesto exacto
        </span>

        <!-- H1 -->
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white leading-tight tracking-tight">
          Tu moto merece<br/>
          <span class="text-[#E85A0C]">las mejores piezas</span>
        </h1>

        <p class="text-white/60 text-base leading-relaxed">
          {productos.length}+ repuestos disponibles para todas las marcas. Consulta disponibilidad directamente por WhatsApp.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href="/catalogo"
            class="inline-flex items-center justify-center gap-2 bg-[#E85A0C] hover:bg-[#C94E0A] text-white font-bold px-7 py-3.5 rounded-[8px] text-sm transition-colors shadow-lg shadow-[#E85A0C]/25"
          >
            Ver catálogo completo
          </a>
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 hover:bg-white/5 text-white font-semibold px-7 py-3.5 rounded-[8px] text-sm transition-colors backdrop-blur-sm"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Consultar ahora
          </a>
        </div>

        <!-- Stats -->
        <div class="flex items-center gap-6 pt-4 border-t border-white/10 text-sm">
          <div>
            <span class="text-white font-bold">{productos.length}+</span>
            <span class="text-white/40 ml-1">Repuestos</span>
          </div>
          <div class="w-px h-4 bg-white/15"></div>
          <div>
            <span class="text-white font-bold">{marcas.length}+</span>
            <span class="text-white/40 ml-1">Marcas</span>
          </div>
          <div class="w-px h-4 bg-white/15"></div>
          <div>
            <span class="text-white font-bold">2</span>
            <span class="text-white/40 ml-1">Locales</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CATEGORÍAS ─────────────────────────────────────────────────────── -->
  {categorias.length > 0 && (
    <section class="bg-[#F5F0E8] py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-[#E85A0C] text-xs font-bold uppercase tracking-widest mb-1.5">Explora por categoría</p>
            <h2 class="text-2xl font-extrabold text-[#111]">¿Qué necesita tu moto?</h2>
          </div>
          <a href="/catalogo" class="text-sm font-semibold text-[#E85A0C] hover:text-[#C94E0A] transition-colors hidden sm:block">
            Ver todo →
          </a>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
          {categorias.map(cat => (
            <a
              href={`/catalogo?categoria=${cat.id}`}
              class="group flex flex-col items-center gap-2.5 p-4 bg-white rounded-[12px] border border-black/8 hover:border-[#E85A0C]/40 hover:shadow-md transition-all text-center"
            >
              <span class="text-2xl">{ICONOS_CATEGORIA[cat.nombre] ?? "🔩"}</span>
              <span class="text-xs font-semibold text-[#111] group-hover:text-[#E85A0C] leading-tight transition-colors">{cat.nombre}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── PRODUCTOS DESTACADOS / OFERTAS ─────────────────────────────────── -->
  {destacados.length > 0 && (
    <section class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-end justify-between mb-8">
          <div>
            <p class="text-[#E85A0C] text-xs font-bold uppercase tracking-widest mb-1.5">
              {enPromo.length > 0 ? "Ofertas y destacados" : "Lo más buscado"}
            </p>
            <h2 class="text-2xl font-extrabold text-[#111]">Productos destacados</h2>
          </div>
          <a href="/catalogo" class="text-sm font-semibold text-[#E85A0C] hover:text-[#C94E0A] transition-colors hidden sm:block">
            Catálogo completo →
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {destacados.map(p => <ProductoCard producto={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── BANDA DE CONFIANZA ─────────────────────────────────────────────── -->
  <section class="border-y border-black/8 bg-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { icon: "🛡️", titulo: "Taller de confianza", desc: "Años de experiencia en motos" },
          { icon: "📍", titulo: "2 locales en Riobamba", desc: "Matriz y sucursal disponibles" },
          { icon: "💬", titulo: "Asesoría por WhatsApp", desc: "Respuesta rápida garantizada" },
          { icon: "🔩", titulo: "Repuestos para todas las marcas", desc: "Originales y alternativos" },
        ].map(item => (
          <div class="flex items-start gap-3">
            <span class="text-2xl shrink-0">{item.icon}</span>
            <div>
              <p class="text-sm font-bold text-[#111]">{item.titulo}</p>
              <p class="text-xs text-black/45 mt-0.5">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── MARCAS ─────────────────────────────────────────────────────────── -->
  {marcas.length > 0 && (
    <section class="py-12 bg-[#F5F0E8]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <p class="text-center text-xs font-bold text-black/35 uppercase tracking-widest mb-6">Marcas disponibles</p>
        <div class="flex flex-wrap justify-center gap-2">
          {marcas.map(m => (
            <a
              href={`/catalogo?marca=${m.id}`}
              class="px-3.5 py-1.5 bg-white border border-black/10 rounded-full text-xs font-semibold text-[#111] hover:border-[#E85A0C] hover:text-[#E85A0C] transition-colors"
            >
              {m.nombre}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── SERVICIOS ──────────────────────────────────────────────────────── -->
  {servicios.length > 0 && (
    <section id="servicios" class="py-14 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <p class="text-[#E85A0C] text-xs font-bold uppercase tracking-widest mb-1.5">Taller especializado</p>
          <h2 class="text-2xl font-extrabold text-[#111]">Nuestros servicios</h2>
          <p class="text-black/45 text-sm mt-2">Mantenimiento y reparación con técnicos especializados en motos.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {servicios.map(s => <ServicioCard servicio={s} />)}
        </div>
        <div class="text-center mt-8">
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#111] hover:bg-[#E85A0C] text-white font-bold px-8 py-3.5 rounded-[8px] transition-colors duration-200 text-sm"
          >
            <svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agendar un servicio
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- ── CTA FINAL ──────────────────────────────────────────────────────── -->
  <section class="bg-[#111] py-16 px-4">
    <div class="max-w-2xl mx-auto text-center space-y-5">
      <p class="text-[#E85A0C] text-xs font-bold uppercase tracking-widest">¿No encuentras lo que buscas?</p>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Escríbenos y te ayudamos</h2>
      <p class="text-white/40 text-sm">Cuéntanos el repuesto o servicio que necesitas y te respondemos al instante.</p>
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#E85A0C] hover:bg-[#C94E0A] text-white font-bold px-8 py-3.5 rounded-[8px] transition-colors text-sm shadow-lg shadow-[#E85A0C]/25"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>
  </section>

</Base>
