---
import Base from "../layouts/Base.astro";
import ProductoCard from "../components/ProductoCard.astro";
import ServicioCard from "../components/ServicioCard.astro";
import { getProductosActivos, getServicios, getCategorias, getPromoActiva } from "../lib/productos";
import { urlGeneral } from "../lib/whatsapp";

const [productos, servicios] = await Promise.all([getProductosActivos(), getServicios()]);
const categorias = getCategorias(productos);

// Primero los de promo activa, luego los con imagen
const enPromo = productos.filter(p => getPromoActiva(p));
const conImagen = productos.filter(p => p.imagen_url && !getPromoActiva(p));
const sinImagen = productos.filter(p => !p.imagen_url && !getPromoActiva(p));
const destacados = [...enPromo, ...conImagen, ...sinImagen].slice(0, 8);

const waGeneral = urlGeneral();

const ICONOS_CATEGORIA: Record<string, string> = {
  "Motor": "⚙️", "Suspensión": "🔧", "Frenos": "🛑", "Transmisión": "⛓️",
  "Eléctrico": "⚡", "Carrocería": "🏍️", "Lubricantes": "🛢️", "Accesorios": "🎽",
  "Llantas": "🔵", "Filtros": "🔩", "Pastillas": "⬛", "Amortiguadores": "🔧",
};

const ICONOS_SERVICIO: Record<string, string> = {
  "cambio de aceite": "🛢️", "aceite": "🛢️",
  "frenos": "🛑", "pastillas": "🛑",
  "suspensión": "🔧", "amortiguador": "🔧",
  "motor": "⚙️", "carburador": "⚙️",
  "eléctrico": "⚡", "batería": "⚡", "luces": "⚡",
  "llanta": "🔵", "neumático": "🔵",
  "cadena": "⛓️", "transmisión": "⛓️",
  "lavado": "🚿", "limpieza": "🚿",
  "diagnóstico": "🔍",
};

function getIconoServicio(nombre: string): string {
  const lower = nombre.toLowerCase();
  for (const [key, icon] of Object.entries(ICONOS_SERVICIO)) {
    if (lower.includes(key)) return icon;
  }
  return "🔩";
}
---

<Base
  title="La Casa del Súper Cross | Repuestos y taller de motos en Riobamba"
  description="Repuestos y servicios de mantenimiento para motos en Riobamba, Ecuador. Amortiguadores, frenos, motor, transmisión y más. Consulta por WhatsApp."
>

  <!-- Hero -->
  <section class="relative min-h-[480px] sm:min-h-[560px] flex items-center overflow-hidden bg-gray-950">
    <img
      src="/banner.jpeg"
      alt="La Casa del Súper Cross"
      class="absolute inset-0 w-full h-full object-cover opacity-40"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-gray-950/90 via-gray-950/60 to-transparent"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="max-w-xl space-y-6">
        <div class="inline-flex items-center gap-2 bg-orange-500/20 border border-orange-500/30 text-orange-300 text-xs font-semibold px-3 py-1.5 rounded-full">
          <span class="w-1.5 h-1.5 bg-orange-400 rounded-full animate-pulse"></span>
          Riobamba, Ecuador
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          Tu moto siempre<br/>
          <span class="text-orange-400">lista para rodar</span>
        </h1>
        <p class="text-gray-300 text-lg leading-relaxed">
          Repuestos originales y servicio técnico especializado. Más de {productos.length} productos disponibles.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href="/catalogo"
            class="inline-flex items-center justify-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-bold px-8 py-3.5 rounded-xl text-base transition-colors shadow-lg shadow-orange-500/30"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
            </svg>
            Ver catálogo
          </a>
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-8 py-3.5 rounded-xl text-base transition-colors backdrop-blur-sm"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Consultar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-orange-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 grid grid-cols-3 gap-4 text-white text-center">
      <div>
        <p class="text-xl sm:text-2xl font-extrabold">{productos.length}+</p>
        <p class="text-xs sm:text-sm text-orange-100">Repuestos</p>
      </div>
      <div>
        <p class="text-xl sm:text-2xl font-extrabold">{servicios.length}+</p>
        <p class="text-xs sm:text-sm text-orange-100">Servicios</p>
      </div>
      <div>
        <p class="text-xl sm:text-2xl font-extrabold">2</p>
        <p class="text-xs sm:text-sm text-orange-100">Locales</p>
      </div>
    </div>
  </section>

  <!-- Categorías -->
  {categorias.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900">Categorías</h2>
          <p class="text-gray-500 text-sm mt-1">Encuentra el repuesto por tipo</p>
        </div>
        <a href="/catalogo" class="text-sm font-semibold text-orange-500 hover:text-orange-600 transition-colors">
          Ver todos →
        </a>
      </div>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
        {categorias.map(cat => (
          <a
            href={`/catalogo?categoria=${cat.id}`}
            class="flex flex-col items-center gap-2 p-3 sm:p-4 rounded-2xl bg-white border border-gray-100 hover:border-orange-300 hover:bg-orange-50 transition-all text-center group shadow-sm hover:shadow-md"
          >
            <span class="text-2xl sm:text-3xl">{ICONOS_CATEGORIA[cat.nombre] ?? "🔩"}</span>
            <span class="text-xs font-semibold text-gray-700 group-hover:text-orange-600 leading-tight">{cat.nombre}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Productos en oferta / destacados -->
  {destacados.length > 0 && (
    <section class="bg-white py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-2xl font-extrabold text-gray-900">
              {enPromo.length > 0 ? "Ofertas y destacados" : "Productos destacados"}
            </h2>
            <p class="text-gray-500 text-sm mt-1">Los más populares de nuestro catálogo</p>
          </div>
          <a href="/catalogo" class="text-sm font-semibold text-orange-500 hover:text-orange-600 transition-colors">
            Ver catálogo completo →
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {destacados.map(p => <ProductoCard producto={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Servicios del taller -->
  {servicios.length > 0 && (
    <section id="servicios" class="py-14 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-2 bg-orange-100 text-orange-700 text-xs font-bold px-3 py-1.5 rounded-full mb-4">
            🔧 Taller especializado
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">Nuestros servicios</h2>
          <p class="text-gray-500 mt-2 max-w-md mx-auto">Mantenimiento y reparación con técnicos especializados en motos.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {servicios.map(s => (
            <ServicioCard servicio={s} icon={getIconoServicio(s.nombre)} />
          ))}
        </div>
        <div class="text-center mt-8">
          <a
            href={waGeneral}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3.5 rounded-xl transition-colors shadow-md shadow-green-200"
          >
            <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Agendar un servicio
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA final -->
  <section class="bg-gray-900 py-16 px-4">
    <div class="max-w-2xl mx-auto text-center space-y-5">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">¿No encuentras lo que buscas?</h2>
      <p class="text-gray-400">Escríbenos y te ayudamos a encontrar el repuesto o servicio que necesitas.</p>
      <a
        href={waGeneral}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3.5 rounded-xl transition-colors text-lg"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Escribir por WhatsApp
      </a>
    </div>
  </section>

</Base>
